# Pinned CI images and tool versions. Single source of truth.
# Tool versions for harness-builder packed tools must match
# storage-cert-harness-images/ci/config/images.env (virtbench, kube-burner,
# kube-burner-ocp, oc/kubectl via OPENSHIFT_CLIENT_VERSION). See
# Docs/Design/image-builds/harness-images-version-alignment.md.
# Sourced by ci/scripts/images.sh (ci/scripts/ci-utils.sh, ci/scripts/install-tools.sh,
# ci/scripts/sync-images-yml.sh).
#
# GitLab cannot source dotenv for `image:` (resolved at YAML parse time).
# After editing this file run: ./ci/scripts/sync-images-yml.sh
# Override any key by exporting it before a script (existing env wins).

# Go jobs use this compiler and Go tooling.
GO_IMAGE=registry.access.redhat.com/ubi10/go-toolset:1.26.7-1788946735
# Digest-pinned harness-builder tool payload (storage-cert-harness-images release path).
# HARNESS_BUILDER_VERSION must match storage-cert-harness-images/BUILDER-VERSION and the Quay tag for BUILD_IMAGE.
HARNESS_BUILDER_VERSION=0.1.10
BUILD_IMAGE=quay.io/virtarraycert/harness-builder@sha256:d36d6b1fc8e227ea8cf7fa3d8018049f68f42e0222a2fda90766ed719507c494
# Runtime must match the Python interpreter used to build virtbench.
RUNTIME_IMAGE=registry.access.redhat.com/ubi9/python-312-minimal:9.8
# UBI minor stream (latest rebuild in 9.8 / 9.7). Not :latest (can jump minors).
YAML_LINT_IMAGE=registry.access.redhat.com/ubi9/python-311:9.8
MD_LINT_IMAGE=registry.access.redhat.com/ubi9/nodejs-20:9.7
BUILDAH_IMAGE=quay.io/buildah/stable:v1.39
CI_TOOLS_IMAGE=quay.io/virtarraycert/ci_tools
QUAY_IMAGE=quay.io/virtarraycert/storage-cert-harness

GOLANGCI_LINT_VERSION=v2.13.2
ACTIONLINT_VERSION=v1.7.12
TRIVY_VERSION=v0.74.0
DIVE_VERSION=v0.13.1
HADOLINT_VERSION=v2.14.0
GOSEC_VERSION=v2.29.0

# Image contents: additional binaries shipped alongside harness.
KUBE_BURNER_VERSION=v2.8.5
KUBE_BURNER_OCP_VERSION=v1.12.7
# Core dependency when building kube-burner-ocp from source in harness-builder (git mode); unused by slim harness Containerfile.
KUBE_BURNER_CORE_REF=main
OPENSHIFT_CLIENT_VERSION=4.22.15
VIRTBENCH_VERSION=v2.0.0
KUBEVIRT_VERSION=v1.9.0
